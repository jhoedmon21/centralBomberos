// ============================================================
//  B-35 Camaná · Central de Mando GIS — Esquema de base de datos
//  PostgreSQL en Neon: url agrupada (PgBouncer) para la app y
//  directUrl sin pooler para migraciones (prisma db push / migrate).
//  El SQLite local (dev.db) quedó como respaldo previo a la migración.
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

/// Reporte de emergencia recibido (WhatsApp, 116, manual o webhook oficial)
model Incident {
  id            Int      @id @default(autoincrement())
  title         String
  address       String
  lat           Float
  lng           Float
  severity      String   @default("alta") // critica | alta | media | baja
  status        String   @default("reportado") // reportado | despachado | en_escena | controlado | cerrado
  source        String   @default("whatsapp") // whatsapp | telefono116 | manual | webhook | simulacion
  reporterName  String?
  reporterPhone String?
  photoUrl      String?
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Hitos de la atención
  dispatchAt    DateTime?
  arrivalAt     DateTime?
  closedAt      DateTime?
  /// Momento en que la unidad confirmó el despacho desde la app (null = sin aceptar)
  acceptedAt    DateTime?
  /// Punto de salida de la unidad al despacharla (cuartel) — trayecto tipo Uber
  departLat     Float?
  departLng     Float?

  unitId          Int?
  unit            Unit?            @relation(fields: [unitId], references: [id])
  events          IncidentEvent[]
  missionReports  MissionReport[]
  unitAssignments IncidentUnit[]

  @@index([status])
  @@index([createdAt])
  @@index([unitId, status])
}

/// Asignación de una unidad a un incidente (despacho multi-unidad).
/// Una emergencia puede llevar varias unidades; cada una acepta por su lado.
model IncidentUnit {
  incidentId   Int
  incident     Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  unitId       Int
  unit         Unit     @relation(fields: [unitId], references: [id], onDelete: Cascade)
  dispatchedAt DateTime @default(now())
  /// Momento en que ESA unidad aceptó el despacho desde la app
  acceptedAt   DateTime?

  @@id([incidentId, unitId])
  @@index([unitId, incidentId])
}

/// Unidad de bomberos disponible para despacho
model Unit {
  id        Int        @id @default(autoincrement())
  code      String     @unique // B-12, C-3, R-7...
  name      String
  type      String     @default("bomba") // bomba | cisterna | rescate | ambulancia | mando
  status    String     @default("disponible") // disponible | en_ruta | en_escena | regresando | fuera_servicio
  /// Marca de tiempo del último cambio de estado (resuelve conflictos: gana el más reciente)
  statusAt  DateTime   @default(now())
  /// Quién cambió el estado: unidad (app) | operador (central) | sistema
  statusSource String  @default("sistema")
  /// Época de sesiones: incrementar invalida los JWT de esta unidad (cierre remoto)
  sessionEpoch Int      @default(0)
  station   String?
  crew      Int?
  lat       Float?
  lng       Float?
  createdAt DateTime   @default(now())
  incidents      Incident[]
  items          UnitItem[]
  pushSubs       PushSubscription[]
  dispatches     IncidentUnit[]
  gpsPoints      GpsPoint[]
  chatMessages   ChatMessage[]

  @@index([status])
}

/// Material o implemento del inventario de una unidad
model UnitItem {
  id          Int      @id @default(autoincrement())
  unitId      Int
  unit        Unit     @relation(fields: [unitId], references: [id], onDelete: Cascade)
  name        String
  category    String   @default("equipo") // extintor | manguera | herramienta | rescate | medico | comunicacion | epp | equipo
  quantity    Int      @default(1)
  condition   String   @default("bueno") // bueno | regular | malo
  /// Compartimento del vehículo para el visor 3D (c1..c6); null = sin ubicación
  compartment String?
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  checks      EquipmentCheck[]

  @@index([unitId])
}

/// Hidrante georreferenciado
model Hydrant {
  id        Int     @id @default(autoincrement())
  code      String? @unique
  lat       Float
  lng       Float
  pressure  String? // buena | media | baja
  diameter  Int?    // milímetros
  situation String  @default("operativo") // operativo | mantenimiento | fuera_servicio
  photoUrl  String?
  notes     String?
}

/// Punto de riesgo para planificación táctica
model RiskPoint {
  id        Int      @id @default(autoincrement())
  name      String
  type      String // gasolinera | almacen | mercado | industria | gas | terminal
  level     String @default("medio") // alto | medio | bajo
  lat       Float
  lng       Float
}

/// Tramo de vía peligroso para el tránsito de las unidades (curvas, pendientes,
/// derrumbes…) con su geometría — se avisa al conductor cuando la ruta lo cruza.
model DangerZone {
  id        Int      @id @default(autoincrement())
  name      String
  kind      String   @default("curvas") // curvas | pendiente | angostamiento | derrumbes | niebla | cruce
  level     String   @default("medio") // alto | medio | bajo
  advisory  String?
  /// GeoJSON LineString (JSON) del tramo peligroso: [[lng,lat], …]
  path      String
  createdAt DateTime @default(now())
}

/// Bitácora: todo lo que ocurre en un incidente (auditoría + línea de tiempo)
model IncidentEvent {
  id         Int      @id @default(autoincrement())
  incidentId Int
  incident   Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  type       String // creado | despacho | llegada | estado | mensaje | nota | cierre
  message    String
  actor      String   @default("sistema") // operador | ciudadano | unidad | sistema
  createdAt  DateTime @default(now())

  @@index([incidentId])
  @@index([createdAt])
}

/// Configuración de la central (números de WhatsApp, alertas, etc.)
model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

// ============================================================
//  FuegoMap Unidades · PWA para tablets de los vehículos
// ============================================================

/// Usuario de la app de unidades (conductor o jefe de guardia)
model AppUser {
  id           Int      @id @default(autoincrement())
  email        String   @unique
  passwordHash String
  name         String
  role         String   @default("unidad") // unidad | jefe
  /// Incrementarlo invalida todos los JWT emitidos (cierre de sesión remota)
  tokenVersion Int      @default(0)
  createdAt    DateTime @default(now())
}

/// Suscripción Web Push de la tablet de una unidad
model PushSubscription {
  id        Int      @id @default(autoincrement())
  // Null = tablet de UN BOMBERO sin unidad (modo bombero): recibe pushes de
  // emergencias nuevas pero no despachos de misión.
  unitId    Int?
  unit      Unit?    @relation(fields: [unitId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  @@index([unitId])
}

/// Registro de operaciones idempotentes de la app: reintentar la cola
/// sin conexión no duplica datos (clave: scope + opId del cliente).
model Operation {
  id        Int      @id @default(autoincrement())
  scope     String // p. ej. "unit:3"
  opId      String
  kind      String // status | equipment_check | hydrant_new | hydrant_status | close_mission | mission_accept
  response  String // JSON de la primera respuesta (se repite en reintentos)
  createdAt DateTime @default(now())

  @@unique([scope, opId])
  @@index([createdAt])
}

/// Historial GPS por unidad (solo se graba con misión activa: los pings en
/// reposo no aportan al recorrido). La posición «actual» sigue en Unit.lat/lng.
model GpsPoint {
  id     Int     @id @default(autoincrement())
  unitId Int
  unit   Unit    @relation(fields: [unitId], references: [id], onDelete: Cascade)
  lat    Float
  lng    Float
  at     DateTime @default(now())

  @@index([unitId, at])
}

/// Mensajería central ↔ unidad (equipo de Bryx: chat corto de comando)
model ChatMessage {
  id       Int      @id @default(autoincrement())
  unitId   Int
  unit     Unit     @relation(fields: [unitId], references: [id], onDelete: Cascade)
  /// central | unidad
  fromRole String
  body     String
  at       DateTime @default(now())

  @@index([unitId, at])
}

/// Cierre de misión reportado desde la app de la unidad
model MissionReport {
  id             Int      @id @default(autoincrement())
  incidentId     Int
  incident       Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  unitId         Int
  result         String // controlado | sin_novedad | falsa_alarma | derivado
  injured        Int      @default(0)
  observations   String?
  photoUrl       String?
  closedByUnitAt DateTime @default(now())

  @@index([incidentId])
}

/// Revisión de un material del checklist diario de la unidad (se marca sin internet)
model EquipmentCheck {
  id         Int      @id @default(autoincrement())
  unitId     Int
  itemId     Int
  unitItem   UnitItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  day        String // YYYY-MM-DD
  checkedAt  DateTime @default(now())

  @@unique([unitId, itemId, day])
  @@index([unitId])
}

// ============================================================
//  Central CAD · acceso, auditoría y preplans operativos
// ============================================================

/// Operador de la central (CAD): roles jefe | operador | lectura.
/// Separado de AppUser (tablets) para que las claves y las sesiones
/// del operador nunca invaliden las de los vehículos.
model OperatorUser {
  id           Int       @id @default(autoincrement())
  email        String    @unique
  passwordHash String
  name         String
  role         String    @default("operador") // jefe | operador | lectura
  active       Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
}

/// Auditoría del sistema: quién hizo qué (accesos, despachos, borrados,
/// cambios de configuración). La verá el jefe en «Bitácora del sistema».
model AuditLog {
  id     Int      @id @default(autoincrement())
  actor  String // «Op. Nombre · jefe» | «unidad B-12» | «sistema»
  action String // login | login_fail | logout | dispatch | unit_delete | hydrant_create | …
  detail String? // JSON con los datos del evento
  at     DateTime @default(now())

  @@index([at])
}

/// Ficha operativa de un edificio de riesgo (preplan): lo que el equipo
/// necesita saber al llegar — llaves de acceso, pisos, peligros, Contacto.
model Preplan {
  id           Int      @id @default(autoincrement())
  title        String
  address      String
  lat          Float
  lng          Float
  /// Pisos, área, geometría del predio (texto libre)
  layout       String?
  /// Peligros preidentificados: LPG, gases, CICT, alta ocupación…
  hazards      String?
  /// Llaves de acceso, portones, tableros eléctricos
  keysInfo     String?
  /// Puntos de agua: cisternas, piscinas, pozos (además de los hidrantes GIS)
  waterSources String?
  contactName  String?
  contactPhone String?
  notes        String?
  /// JSON array de URLs de fotos (fachada, accesos, interiores)
  photos       String?
  status       String   @default("activo") // activo | inactivo
  createdBy    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([lat, lng])
}
